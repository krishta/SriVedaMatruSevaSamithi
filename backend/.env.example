# Copy to .env and fill in real values before go-live — never commit the real .env.
DATABASE_URL=sqlite:///./data/svmss.db
JWT_SECRET=CHANGE_ME_dev_only_placeholder_secret
JWT_ACCESS_TTL_MIN=20
JWT_REFRESH_TTL_DAYS=7

# SMTP — TBD: real SVMSS mailbox/app-password not yet supplied
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=TBD_svmss_account@gmail.com
SMTP_PASSWORD=TBD_app_password
SMTP_FROM=TBD_svmss_account@gmail.com

STORAGE_BACKEND=local
UPLOAD_DIR=./data/uploads
RECEIPTS_DIR=./data/receipts

CORS_ALLOWED_ORIGINS=http://localhost:4200
RATE_LIMIT_DONATIONS_PER_HOUR=10
RATE_LIMIT_LOOKUP_PER_HOUR=20

# NGO settings seed — TBD: real UPI id / bank account not yet supplied
NGO_NAME=Sri Veda Matru Seva Samiti
NGO_ADDRESS=TBD_registered_address
NGO_UPI_ID=TBD@upi
NGO_BANK_ACCOUNT_NAME=TBD
NGO_BANK_ACCOUNT_NO=TBD
NGO_BANK_IFSC=TBD
NGO_BANK_NAME=TBD

# First admin user seed — rotate this password immediately after first login
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin